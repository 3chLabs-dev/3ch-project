PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public

# Toss Payments server key. Never expose this value to the web application.
TOSS_SECRET_KEY=test_gsk_your_secret_key

# 32-byte AES key used to encrypt saved billing keys.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BILLING_ENCRYPTION_KEY=64_hex_characters

# Secret required by POST /api/payment/billing/run-renewals.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BILLING_CRON_SECRET=your_random_cron_secret
