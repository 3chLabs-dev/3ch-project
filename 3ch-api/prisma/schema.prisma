generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      Int       @id @default(autoincrement())
  email                   String    @unique
  password_hash           String?
  password_reset_required Boolean   @default(false)
  name                    String?
  nickname                String?
  phone                   String?
  auth_provider           String
  provider_id             String?
  is_admin                Boolean   @default(false)
  system_role             String    @default("USER") @db.VarChar(20)
  member_code             String?   @unique
  created_at              DateTime  @default(now())
  updated_at              DateTime  @default(now()) @updatedAt
  deleted_at              DateTime?

  leagues                       League[]                 @relation("LeagueCreator")
  teams                         Team[]                   @relation("TeamCreator")
  created_groups                Group[]                  @relation("GroupCreator")
  group_memberships             GroupMember[]
  draws                         Draw[]                   @relation("DrawCreator")
  league_programs               LeagueProgram[]          @relation("LeagueProgramCreator")
  league_program_templates      LeagueProgramTemplate[]
  group_rankings                GroupRanking[]
  group_ranking_events          GroupRankingEvent[]      @relation("GroupRankingEventMember")
  sport_rankings                SportRanking[]
  sport_ranking_events          SportRankingEvent[]      @relation("SportRankingEventMember")
  support_chat_room             SupportChatRoom?
  support_chat_messages         SupportChatMessage[]
  sent_league_invitations       LeagueInvitedGroup[]     @relation("LeagueInvitationSender")
  accepted_league_invitations   LeagueInvitedGroup[]     @relation("LeagueInvitationAccepter")
  participant_claims            LeagueParticipantClaim[] @relation("ParticipantClaimApprovedUser")
  requested_participant_claims  LeagueParticipantClaim[] @relation("ParticipantClaimRequester")
  reviewed_participant_claims   LeagueParticipantClaim[] @relation("ParticipantClaimReviewer")
  created_group_pre_members     GroupPreMember[]         @relation("GroupPreMemberCreator")
  linked_group_pre_members      GroupPreMember[]         @relation("GroupPreMemberLinkedUser")
  requested_group_member_claims GroupMemberClaim[]       @relation("GroupMemberClaimRequester")
  reviewed_group_member_claims  GroupMemberClaim[]       @relation("GroupMemberClaimReviewer")
  created_ranking_seasons       GroupRankingSeason[]     @relation("GroupRankingSeasonCreator")
  billed_leagues                League[]                 @relation("LeagueBillingOwner")
  subscriptions                 Subscription[]
  billing_payment_method        BillingPaymentMethod?
  feature_credit_buckets        FeatureCreditBucket[]    @relation("FeatureCreditOwner")
  granted_feature_credits       FeatureCreditBucket[]    @relation("FeatureCreditGranter")
  feature_usage_events          FeatureUsageEvent[]      @relation("FeatureUsageOwner")
  token_purchases               TokenPurchase[]
  external_aliases              UserExternalAlias[]
  coupon_redemptions            CouponRedemption[]       @relation("CouponUser")
  created_coupons               Coupon[]                 @relation("CouponCreator")

  @@map("users")
}

model SupportChatRoom {
  id               Int      @id @default(autoincrement())
  user_id          Int?     @unique
  guest_name       String?  @db.VarChar(40)
  guest_token_hash String?  @unique
  status           String   @default("open") @db.VarChar(20)
  last_message_at  DateTime @default(now()) @db.Timestamptz(6)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  user     User?                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  messages SupportChatMessage[]

  @@index([last_message_at(sort: Desc)])
  @@map("support_chat_rooms")
}

model SupportChatMessage {
  id          Int      @id @default(autoincrement())
  room_id     Int
  sender_type String   @db.VarChar(20)
  sender_id   Int?
  content     String   @db.Text
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  room   SupportChatRoom @relation(fields: [room_id], references: [id], onDelete: Cascade)
  sender User?           @relation(fields: [sender_id], references: [id], onDelete: Cascade)

  @@index([room_id, id])
  @@map("support_chat_messages")
}

model Group {
  id              String    @id @default(uuid())
  name            String    @unique
  description     String?
  sport           String?
  region_city     String?
  region_district String?
  founded_at      DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @default(now()) @updatedAt

  address        String?
  address_detail String?
  lat            Float?
  lng            Float?
  club_code      String? @unique

  created_by_id Int
  creator       User @relation("GroupCreator", fields: [created_by_id], references: [id])

  members              GroupMember[]
  leagues              League[]
  ranking_setting      GroupRankingSetting?
  rankings             GroupRanking[]
  ranking_events       GroupRankingEvent[]
  sport_ranking_events SportRankingEvent[]
  invited_leagues      LeagueInvitedGroup[]
  league_participants  LeagueParticipant[]  @relation("ParticipantSourceGroup")
  pre_members          GroupPreMember[]
  ranking_seasons      GroupRankingSeason[]
  user_external_aliases UserExternalAlias[]

  @@map("groups")
}

model UserExternalAlias {
  id               String   @id @default(uuid())
  user_id          Int
  group_id         String
  alias            String   @db.VarChar(60)
  normalized_alias String   @db.VarChar(60)
  source           String   @default("external") @db.VarChar(30)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  group Group @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@unique([user_id, group_id, source, normalized_alias])
  @@index([group_id, normalized_alias])
  @@map("user_external_aliases")
}

model GroupMember {
  id        String   @id @default(uuid())
  role      String   @default("member") // "owner", "admin", "member"
  division  String?
  joined_at DateTime @default(now())
  display_order Int?
  is_primary    Boolean  @default(false)

  group_id String
  group    Group  @relation(fields: [group_id], references: [id], onDelete: Cascade)

  user_id Int
  user    User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([group_id, user_id])
  @@map("group_members")
}

model GroupRankingSetting {
  group_id           String   @id
  enabled            Boolean  @default(true)
  algorithm          String   @default("elo")
  base_rating        Int      @default(1500)
  k_league           Int      @default(24)
  k_tournament       Int      @default(32)
  include_tournament Boolean  @default(true)
  exclude_guests     Boolean  @default(true)
  created_at         DateTime @default(now())
  updated_at         DateTime @default(now()) @updatedAt

  group Group @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@map("group_ranking_settings")
}

model GroupRanking {
  id              String    @id @default(dbgenerated("gen_random_uuid()::text"))
  group_id        String
  member_id       Int
  rating          Int       @default(1500)
  rank            Int?
  wins            Int       @default(0)
  losses          Int       @default(0)
  matches_played  Int       @default(0)
  win_rate        Float     @default(0)
  streak          Int       @default(0)
  best_win_rating Int?
  last_match_at   DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @default(now()) @updatedAt

  group  Group @relation(fields: [group_id], references: [id], onDelete: Cascade)
  member User  @relation(fields: [member_id], references: [id], onDelete: Cascade)

  @@unique([group_id, member_id])
  @@index([group_id, rank])
  @@index([group_id, rating])
  @@map("group_rankings")
}

model GroupRankingEvent {
  id                 String   @id @default(dbgenerated("gen_random_uuid()::text"))
  group_id           String
  member_id          Int
  opponent_member_id Int?
  league_id          String?
  league_match_id    String?
  before_rating      Int
  after_rating       Int
  delta              Int
  result             String
  match_type         String
  created_at         DateTime @default(now())

  group  Group @relation(fields: [group_id], references: [id], onDelete: Cascade)
  member User  @relation("GroupRankingEventMember", fields: [member_id], references: [id], onDelete: Cascade)

  @@index([group_id, member_id, created_at])
  @@index([league_match_id])
  @@map("group_ranking_events")
}

model SportRanking {
  id              String    @id @default(dbgenerated("gen_random_uuid()::text"))
  sport           String
  member_id       Int
  rating          Int       @default(1500)
  rank            Int?
  wins            Int       @default(0)
  losses          Int       @default(0)
  matches_played  Int       @default(0)
  win_rate        Float     @default(0)
  streak          Int       @default(0)
  best_win_rating Int?
  last_match_at   DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @default(now()) @updatedAt

  member User @relation(fields: [member_id], references: [id], onDelete: Cascade)

  @@unique([sport, member_id])
  @@index([sport, rank])
  @@index([member_id])
  @@map("sport_rankings")
}

model SportRankingEvent {
  id                 String   @id @default(dbgenerated("gen_random_uuid()::text"))
  sport              String
  member_id          Int
  opponent_member_id Int?
  group_id           String?
  league_id          String?
  league_match_id    String?
  before_rating      Int
  after_rating       Int
  delta              Int
  result             String
  match_type         String
  created_at         DateTime @default(now())

  member User   @relation("SportRankingEventMember", fields: [member_id], references: [id], onDelete: Cascade)
  group  Group? @relation(fields: [group_id], references: [id], onDelete: SetNull)

  @@index([sport, member_id, created_at])
  @@index([league_match_id])
  @@map("sport_ranking_events")
}

model League {
  id                     String    @id @default(uuid())
  name                   String
  description            String?
  type                   String
  format                 String?
  sport                  String
  start_date             DateTime
  end_date               DateTime?
  court_count            Int?
  status                 String    @default("draft") // e.g., "draft", "active", "completed"
  rules                  String?
  notice                 String?
  entry_fee              String?
  bank_account           String?
  sort_order             String?   @default("부수")
  recruit_count          Int       @default(0)
  participant_count      Int       @default(0)
  league_code            String?   @unique
  join_permission        String    @default("public") // "public" | "club_only"
  visibility             String    @default("club_only") // "club_only" | "public"
  premium_enabled        Boolean   @default(false)
  premium_started_at     DateTime? @db.Timestamptz(6)
  premium_expires_at     DateTime? @db.Timestamptz(6)
  venue_name             String?   @db.VarChar(120)
  venue_address          String?
  venue_lat              Float?
  venue_lng              Float?
  venue_region_city      String?   @db.VarChar(80)
  venue_region_district  String?   @db.VarChar(80)
  tournament_seeding     String?
  tournament_advancement String?
  tournament_rules       String?
  advance_count          Int?
  advance_method         String?
  finals_advance         Int?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @default(now()) @updatedAt

  created_by_id    Int
  creator          User  @relation("LeagueCreator", fields: [created_by_id], references: [id])
  billing_owner_id Int?
  billing_owner    User? @relation("LeagueBillingOwner", fields: [billing_owner_id], references: [id], onDelete: SetNull)

  group_id String?
  group    Group?  @relation(fields: [group_id], references: [id], onDelete: Cascade)

  teams                    Team[]
  matches                  Match[]
  participants             LeagueParticipant[]
  league_matches           LeagueMatch[]
  participant_replacements LeagueParticipantReplacement[]
  program                  LeagueProgram?
  draws                    Draw[]
  invited_groups           LeagueInvitedGroup[]

  @@map("leagues")
}

model PricingPlan {
  id             Int       @id @default(autoincrement())
  code           String    @unique @db.VarChar(30)
  name           String    @db.VarChar(50)
  badge_text     String?   @db.VarChar(50)
  price          Int       @default(0)
  original_price Int?
  billing_cycle  String    @default("MONTHLY") @db.VarChar(20)
  sale_start_at  DateTime? @db.Timestamptz(6)
  sale_end_at    DateTime? @db.Timestamptz(6)
  features       Json      @default("[]")
  feature_limits Json      @default("{}")
  display_order  Int       @default(0)
  is_visible     Boolean   @default(true)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([is_visible, display_order])
  @@map("pricing_plans")
}

model TokenPackage {
  id            Int      @id @default(autoincrement())
  code          String   @unique @db.VarChar(40)
  name          String   @db.VarChar(80)
  price         Int
  credits       Json     @default("{}")
  display_order Int      @default(0)
  is_visible    Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  purchases     TokenPurchase[]

  @@index([is_visible, display_order])
  @@map("token_packages")
}

model TokenPurchase {
  id          String   @id @default(uuid())
  user_id     Int
  package_id  Int
  order_id    String   @unique @db.VarChar(100)
  payment_key String   @db.VarChar(200)
  amount      Int
  status      String   @default("PAID") @db.VarChar(20)
  credits     Json     @default("{}")
  expires_at  DateTime @db.Timestamptz(6)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  user    User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  package TokenPackage @relation(fields: [package_id], references: [id], onDelete: Restrict)

  @@index([user_id, created_at])
  @@map("token_purchases")
}

model Subscription {
  id          Int      @id @default(autoincrement())
  user_id     Int
  plan        String   @db.VarChar(20)
  order_id    String   @unique @db.VarChar(100)
  payment_key String   @db.VarChar(200)
  amount      Int
  status      String   @default("ACTIVE") @db.VarChar(20)
  started_at  DateTime @default(now()) @db.Timestamptz(6)
  expires_at  DateTime @db.Timestamptz(6)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  billing_method_id    Int?
  is_recurring         Boolean   @default(false)
  cancel_at_period_end Boolean   @default(false)
  canceled_at          DateTime? @db.Timestamptz(6)

  user           User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  billing_method BillingPaymentMethod? @relation(fields: [billing_method_id], references: [id], onDelete: SetNull)
  credit_buckets FeatureCreditBucket[]

  @@index([user_id, status, expires_at])
  @@index([status, is_recurring, cancel_at_period_end, expires_at], map: "subscriptions_recurring_due_idx")
  @@map("subscriptions")
}

model BillingPaymentMethod {
  id                    Int       @id @default(autoincrement())
  user_id               Int       @unique
  customer_key          String    @unique @db.VarChar(100)
  billing_key_encrypted String?   @db.Text
  card_company          String?   @db.VarChar(50)
  card_number           String?   @db.VarChar(50)
  status                String    @default("PENDING") @db.VarChar(20)
  authenticated_at      DateTime? @db.Timestamptz(6)
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  user          User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@index([status])
  @@map("billing_payment_methods")
}

model FeatureCreditBucket {
  id               String    @id @default(uuid())
  user_id          Int
  feature          String    @db.VarChar(40)
  source           String    @db.VarChar(20)
  initial_amount   Int?
  remaining_amount Int?
  starts_at        DateTime  @default(now()) @db.Timestamptz(6)
  expires_at       DateTime? @db.Timestamptz(6)
  subscription_id  Int?
  source_ref       String?   @db.VarChar(120)
  granted_by_id    Int?
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  user         User                @relation("FeatureCreditOwner", fields: [user_id], references: [id], onDelete: Cascade)
  granted_by   User?               @relation("FeatureCreditGranter", fields: [granted_by_id], references: [id], onDelete: SetNull)
  subscription Subscription?       @relation(fields: [subscription_id], references: [id], onDelete: Cascade)
  usage_events FeatureUsageEvent[]

  @@index([user_id, feature, starts_at, expires_at])
  @@index([subscription_id])
  @@map("feature_credit_buckets")
}

model FeatureUsageEvent {
  id               String   @id @default(uuid())
  user_id          Int
  feature          String   @db.VarChar(40)
  action           String   @db.VarChar(20)
  amount           Int      @default(1)
  request_key      String?  @unique @db.VarChar(120)
  credit_bucket_id String?
  reference_type   String?  @db.VarChar(40)
  reference_id     String?  @db.VarChar(120)
  metadata         Json?
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  user          User                 @relation("FeatureUsageOwner", fields: [user_id], references: [id], onDelete: Cascade)
  credit_bucket FeatureCreditBucket? @relation(fields: [credit_bucket_id], references: [id], onDelete: SetNull)

  @@index([user_id, feature, created_at])
  @@index([reference_type, reference_id])
  @@map("feature_usage_events")
}

model Coupon {
  id            String   @id @default(uuid())
  code          String   @db.VarChar(50)
  normalized_code String @unique @db.VarChar(50)
  distribution_type String @default("SINGLE") @db.VarChar(20)
  max_redemptions Int?
  name          String   @db.VarChar(100)
  type          String   @db.VarChar(30)
  value         Int
  plan_code     String?  @db.VarChar(30)
  duration_months Int?
  valid_from    DateTime @default(now()) @db.Timestamptz(6)
  valid_until   DateTime @db.Timestamptz(6)
  is_active     Boolean  @default(true)
  created_by_id Int?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  creator       User?    @relation("CouponCreator", fields: [created_by_id], references: [id], onDelete: SetNull)
  redemptions   CouponRedemption[]
  @@index([is_active, valid_from, valid_until])
  @@map("coupons")
}

model CouponRedemption {
  id          String    @id @default(uuid())
  coupon_id   String
  user_id     Int
  status      String    @default("REDEEMED") @db.VarChar(20)
  benefit     Json      @default("{}")
  redeemed_at DateTime  @default(now()) @db.Timestamptz(6)
  applied_at  DateTime? @db.Timestamptz(6)
  applied_order_id String? @unique @db.VarChar(100)
  coupon      Coupon    @relation(fields: [coupon_id], references: [id], onDelete: Restrict)
  user        User      @relation("CouponUser", fields: [user_id], references: [id], onDelete: Restrict)
  @@unique([coupon_id, user_id])
  @@index([user_id, redeemed_at])
  @@map("coupon_redemptions")
}

model LeagueProgram {
  id            String   @id @default(dbgenerated("gen_random_uuid()::text"))
  league_id     String   @unique
  program_data  Json
  created_by_id Int?
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now()) @updatedAt

  league  League @relation(fields: [league_id], references: [id], onDelete: Cascade)
  creator User?  @relation("LeagueProgramCreator", fields: [created_by_id], references: [id], onDelete: SetNull)

  @@map("league_programs")
}

model LeagueParticipant {
  id           String    @id @default(uuid())
  division     String?
  name         String
  member_id    Int?
  paid         Boolean   @default(false)
  arrived      Boolean   @default(false)
  after        Boolean   @default(false)
  sort_order   Int?
  group_name   String?
  is_leader    Boolean   @default(false)
  status       String    @default("active")
  withdrawn_at DateTime?
  created_at   DateTime  @default(now())

  league_id       String
  league          League  @relation(fields: [league_id], references: [id], onDelete: Cascade)
  source_group_id String?
  source_group    Group?  @relation("ParticipantSourceGroup", fields: [source_group_id], references: [id], onDelete: SetNull)

  matches_as_a LeagueMatch[]                  @relation("MatchParticipantA")
  matches_as_b LeagueMatch[]                  @relation("MatchParticipantB")
  replacements LeagueParticipantReplacement[]
  claim        LeagueParticipantClaim?

  @@index([league_id])
  @@index([source_group_id])
  @@map("league_participants")
}

model LeagueProgramTemplate {
  id            String   @id @default(dbgenerated("gen_random_uuid()::text"))
  user_id       Int
  name          String   @db.VarChar(100)
  template_data Json
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now()) @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@map("league_program_templates")
}

model GroupRankingSeason {
  id            String   @id @default(uuid())
  group_id      String
  name          String
  start_date    DateTime @db.Date
  end_date      DateTime @db.Date
  auto_renew    Boolean  @default(false)
  point_rules   Json?
  created_by_id Int
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now()) @updatedAt

  group   Group @relation(fields: [group_id], references: [id], onDelete: Cascade)
  creator User  @relation("GroupRankingSeasonCreator", fields: [created_by_id], references: [id])

  @@index([group_id, start_date, end_date])
  @@map("group_ranking_seasons")
}

model GroupPreMember {
  id             String   @id @default(uuid())
  group_id       String
  name           String
  division       String?
  status         String   @default("active")
  created_by_id  Int
  linked_user_id Int?
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now()) @updatedAt

  group       Group             @relation(fields: [group_id], references: [id], onDelete: Cascade)
  creator     User              @relation("GroupPreMemberCreator", fields: [created_by_id], references: [id])
  linked_user User?             @relation("GroupPreMemberLinkedUser", fields: [linked_user_id], references: [id], onDelete: SetNull)
  claim       GroupMemberClaim?

  @@index([group_id, status])
  @@map("group_pre_members")
}

model GroupMemberClaim {
  id              String    @id @default(uuid())
  pre_member_id   String    @unique
  requested_by_id Int
  reviewed_by_id  Int?
  status          String    @default("pending")
  requested_at    DateTime  @default(now())
  reviewed_at     DateTime?

  pre_member GroupPreMember @relation(fields: [pre_member_id], references: [id], onDelete: Cascade)
  requester  User           @relation("GroupMemberClaimRequester", fields: [requested_by_id], references: [id], onDelete: Cascade)
  reviewer   User?          @relation("GroupMemberClaimReviewer", fields: [reviewed_by_id], references: [id], onDelete: SetNull)

  @@index([requested_by_id, status])
  @@map("group_member_claims")
}

model LeagueInvitedGroup {
  id             String    @id @default(uuid())
  league_id      String
  group_id       String
  status         String    @default("pending")
  invited_by_id  Int
  accepted_by_id Int?
  created_at     DateTime  @default(now())
  responded_at   DateTime?

  league      League @relation(fields: [league_id], references: [id], onDelete: Cascade)
  group       Group  @relation(fields: [group_id], references: [id], onDelete: Cascade)
  invited_by  User   @relation("LeagueInvitationSender", fields: [invited_by_id], references: [id])
  accepted_by User?  @relation("LeagueInvitationAccepter", fields: [accepted_by_id], references: [id])

  @@unique([league_id, group_id])
  @@index([group_id, status])
  @@map("league_invited_groups")
}

model LeagueParticipantClaim {
  participant_id   String    @id
  code_hash        String?
  guest_token_hash String?
  claimed_by_id    Int?
  requested_by_id  Int?
  reviewed_by_id   Int?
  status           String?
  requested_at     DateTime?
  reviewed_at      DateTime?
  claimed_at       DateTime?
  expires_at       DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @default(now()) @updatedAt

  participant  LeagueParticipant @relation(fields: [participant_id], references: [id], onDelete: Cascade)
  claimed_by   User?             @relation("ParticipantClaimApprovedUser", fields: [claimed_by_id], references: [id], onDelete: SetNull)
  requested_by User?             @relation("ParticipantClaimRequester", fields: [requested_by_id], references: [id], onDelete: SetNull)
  reviewed_by  User?             @relation("ParticipantClaimReviewer", fields: [reviewed_by_id], references: [id], onDelete: SetNull)

  @@index([guest_token_hash])
  @@index([requested_by_id, status])
  @@map("league_participant_claims")
}

model LeagueParticipantReplacement {
  id                    String   @id @default(uuid())
  league_id             String
  participant_id        String
  previous_member_id    Int?
  previous_name         String
  previous_division     String?
  replacement_member_id Int?
  replacement_name      String
  replacement_division  String?
  replaced_by_id        Int
  created_at            DateTime @default(now())

  league      League            @relation(fields: [league_id], references: [id], onDelete: Cascade)
  participant LeagueParticipant @relation(fields: [participant_id], references: [id], onDelete: Cascade)

  @@index([league_id, participant_id])
  @@map("league_participant_replacements")
}

model LeagueMatch {
  id          String   @id @default(uuid())
  match_order Int
  score_a     Int?
  score_b     Int?
  court       String?
  status      String   @default("pending")
  created_at  DateTime @default(now())

  league_id String
  league    League @relation(fields: [league_id], references: [id], onDelete: Cascade)

  participant_a_id String?
  participant_a    LeagueParticipant? @relation("MatchParticipantA", fields: [participant_a_id], references: [id], onDelete: SetNull)

  participant_b_id         String?
  participant_b            LeagueParticipant? @relation("MatchParticipantB", fields: [participant_b_id], references: [id], onDelete: SetNull)
  participant_a_roster_ids String[]           @default([])
  participant_b_roster_ids String[]           @default([])
  bracket                  String?
  round_number             Int?
  match_label              String?
  next_match_id            String?
  next_slot                String?
  loser_next_match_id      String?
  loser_next_slot          String?
  is_program               Boolean            @default(false)
  program_round            Int?
  program_block_type       String?
  group_name               String?

  @@index([league_id])
  @@map("league_matches")
}

model Team {
  id         String   @id @default(uuid())
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  league_id String
  league    League @relation(fields: [league_id], references: [id], onDelete: Cascade)

  created_by_id Int
  creator       User @relation("TeamCreator", fields: [created_by_id], references: [id])

  players      Player[]
  home_matches Match[]  @relation("HomeMatches")
  away_matches Match[]  @relation("AwayMatches")

  @@map("teams")
}

model Player {
  id         String   @id @default(uuid())
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  team_id String
  team    Team   @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@map("players")
}

model Match {
  id         String   @id @default(uuid())
  match_date DateTime
  location   String?
  score_home Int?
  score_away Int?
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  league_id String
  league    League @relation(fields: [league_id], references: [id], onDelete: Cascade)

  home_team_id String
  home_team    Team   @relation("HomeMatches", fields: [home_team_id], references: [id])

  away_team_id String
  away_team    Team   @relation("AwayMatches", fields: [away_team_id], references: [id])

  @@map("matches")
}

model Draw {
  id         String   @id @default(dbgenerated("gen_random_uuid()::text"))
  name       String
  draw_code  String?  @unique
  created_at DateTime @default(now())

  league_id String
  league    League @relation(fields: [league_id], references: [id], onDelete: Cascade)

  created_by_id Int
  creator       User @relation("DrawCreator", fields: [created_by_id], references: [id])

  prizes  DrawPrize[]
  winners DrawWinner[]

  @@index([league_id])
  @@map("draws")
}

model DrawPrize {
  id            String @id @default(dbgenerated("gen_random_uuid()::text"))
  prize_name    String
  quantity      Int    @default(1)
  display_order Int    @default(0)

  draw_id String
  draw    Draw   @relation(fields: [draw_id], references: [id], onDelete: Cascade)

  winners DrawWinner[]

  @@index([draw_id])
  @@map("draw_prizes")
}

model DrawWinner {
  id                   String  @id @default(dbgenerated("gen_random_uuid()::text"))
  participant_name     String
  participant_division String?
  display_order        Int     @default(0)

  draw_id String
  draw    Draw   @relation(fields: [draw_id], references: [id], onDelete: Cascade)

  prize_id String
  prize    DrawPrize @relation(fields: [prize_id], references: [id], onDelete: Cascade)

  @@index([draw_id])
  @@index([prize_id])
  @@map("draw_winners")
}
